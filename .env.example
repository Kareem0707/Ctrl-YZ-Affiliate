# ==============================================================
# Ctrl YZ Affiliate — Production Environment Configuration
# Copy to .env (for Prisma CLI) and .env.local (for Next.js)
# ==============================================================

# ── Application URL ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://ctrl-yz-affiliate.vercel.app"

# ── Neon PostgreSQL (Pooled + Direct for Migrations) ──────────
# Pooled connection string (with -pooler host) used by runtime serverless functions
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-your-project-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string used by `prisma migrate deploy` & `prisma db push`
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-your-project.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Authentication & Session Signing ──────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-character-random-secret-key"

# Google OAuth 2.0 Web Client (Authorized Origins must include localhost & Vercel domain)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated list of authorized Admin Google emails
ADMIN_EMAILS="admin@ctrlyz.com"
NEXT_PUBLIC_ADMIN_EMAIL="admin@ctrlyz.com"

# ── Cloud Object Storage (Choose Vercel Blob OR Cloudflare R2) ─
# Option A: Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Option B: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ctrl-yz-assets"
R2_PUBLIC_URL="https://assets.ctrlyz.com"

# ── Verification Channels (WhatsApp OTP / Email SMTP) ─────────
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@ctrlyz.com"

# ── Webhooks & Scheduled Jobs ─────────────────────────────────
WEBHOOK_SIGNING_SECRET="replace-with-webhook-hmac-signing-secret"
CRON_SECRET="replace-with-vercel-cron-bearer-secret"

# ── Distributed Rate Limiting (Optional — Upstash Redis REST) ─
# Falls back safely to in-memory sliding window when unset
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
